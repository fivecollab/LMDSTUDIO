# Copie ce fichier en .env.local et ajoute les mêmes variables dans Vercel
# (Project > Settings > Environment Variables).

# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé « anon » / « publishable » (utilisée pour la connexion à l'admin)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » (secrète, utilisée uniquement côté serveur)
SUPABASE_SERVICE_ROLE_KEY=

# L'accès à /admin se fait avec un compte créé dans Supabase > Authentication > Users.
